  const options = CONTACT_ROLE_OPTIONS[type] || CONTACT_ROLE_OPTIONS.other;
  const currentValue = roleSelect.value || '';

  roleSelect.innerHTML = '<option value="">Select a role/title</option>' + options.map(option => `
