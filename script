// Global error reporting overlay to prevent blank pages on runtime errors
function showAppError(message) {
  try {
    let el = document.getElementById('appErrorBanner');
    if (!el) {
      el = document.createElement('div');
      el.id = 'appErrorBanner';
      el.style.position = 'fixed';
      el.style.top = '12px';
      el.style.right = '12px';
      el.style.maxWidth = '420px';
      el.style.background = '#fee2e2';
      el.style.color = '#991b1b';
      el.style.border = '1px solid #fecaca';
      el.style.padding = '12px 14px';
      el.style.borderRadius = '12px';
      el.style.boxShadow = '0 8px 24px rgba(0,0,0,0.15)';
      el.style.zIndex = '9999';
      el.style.fontSize = '14px';
      document.body.appendChild(el);
    }
    el.textContent = message;
  } catch (err) {
    console.error('showAppError failed:', err);
  }
}

const API_BASE_URL = (function() {
  // In local dev when the static site is served (eg. via python http.server on 8000),
  // we must point API calls to the backend server rather than the static origin
  // (which would return HTML and cause JSON.parse errors). Use backend at 127.0.0.1:5000 by default.
  try {
    const host = window.location.hostname;
    const port = window.location.port;
    if (host === '127.0.0.1' || host === 'localhost') {
      // If running the static server on a non-API port (commonly 8000), prefer backend
      if (port && port !== '5000') return 'http://127.0.0.1:5000/api';
    }
  } catch (e) {
    // fallback to explicit backend
    return 'http://127.0.0.1:5000/api';
  }
  return `${window.location.origin}/api`;
})();

