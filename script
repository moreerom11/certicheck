(function initApplyForm() {
  const nextBtn = document.getElementById("formNext");
  const backBtn = document.getElementById("formBack");
  const volumeSelect = document.getElementById("volume");
  const volumeCustomField = document.getElementById("volumeCustomField");
  const volumeCustomInput = document.getElementById("volumeCustom");
  const orgTypeSelect = document.getElementById("orgType");
  const issuerOrgType = document.getElementById("issuerOrgType");

  if (!nextBtn) return;

  const toggleCustomVolume = () => {
    const isCustom = volumeSelect?.value === "custom";
    if (volumeCustomField) volumeCustomField.style.display = isCustom ? "block" : "none";
    if (volumeCustomInput) {
      volumeCustomInput.required = isCustom;
      if (!isCustom) volumeCustomInput.value = "";
    }
  };

  orgTypeSelect?.addEventListener('change', () => {
    populateContactRoleOptions(orgTypeSelect.value);
    const roleSelect = document.getElementById('contactRole');
    saveApplyDraft({ orgType: orgTypeSelect.value, contactRole: roleSelect?.value || '' });
  });

  issuerOrgType?.addEventListener('change', () => {
    populateCertificateTypeOptions(issuerOrgType.value);
  });

  volumeSelect?.addEventListener("change", () => {
    toggleCustomVolume();
    saveApplyDraft({ volume: volumeSelect.value, volumeCustom: volumeCustomInput?.value || '' });
  });
  volumeCustomInput?.addEventListener('input', () => {
    saveApplyDraft({ volumeCustom: volumeCustomInput.value || '' });
  });

  const formFields = [
    'orgName', 'orgType', 'orgWebsite',
    'contactName', 'contactEmail', 'contactRole',
    'useCase', 'volume', 'volumeCustom', 'wallet'
  ];

  formFields.forEach((id) => {
    const field = document.getElementById(id);
    if (!field) return;

    const saveField = () => {
      const value = field.type === 'checkbox' || field.type === 'radio' ? field.checked : field.value;
      saveApplyDraft({ [id]: value });
    };

    field.addEventListener('input', saveField);
    field.addEventListener('change', saveField);
  });

  const contactName = document.getElementById("contactName");
  const contactEmail = document.getElementById("contactEmail");

  if (contactName && contactEmail) {
    const syncIssuerSuggestion = () => {
      if (!contactEmail.value.trim() || contactEmail.dataset.autoSuggested === '1') {
        const suggestedEmail = buildIssuerEmailSuggestion(contactName.value);
        contactEmail.value = suggestedEmail;
        contactEmail.dataset.autoSuggested = '1';
        saveApplyDraft({ contactEmail: suggestedEmail });
      }
    };

    contactName.addEventListener('input', () => {
      if (!contactEmail.value.trim() || contactEmail.dataset.autoSuggested === '1') {
        syncIssuerSuggestion();
      }
    });

    contactEmail.addEventListener('focus', () => {
      if (!contactEmail.value.trim()) {
        syncIssuerSuggestion();
      }
    });

    contactEmail.addEventListener('blur', () => {
      const value = String(contactEmail.value || '').trim();
      if (!value) {
        contactEmail.value = buildIssuerEmailSuggestion(contactName.value);
        contactEmail.dataset.autoSuggested = '1';
        saveApplyDraft({ contactEmail: contactEmail.value });
        return;
      }
      if (!value.endsWith('@certicheck.com')) {
        contactEmail.value = buildIssuerEmailSuggestion(contactName.value || value.split('@')[0]);
        contactEmail.dataset.autoSuggested = '1';
        saveApplyDraft({ contactEmail: contactEmail.value });
      } else {
        contactEmail.dataset.autoSuggested = '0';
        saveApplyDraft({ contactEmail: value });
      }
    });
  }

  restoreApplyDraft();
  populateContactRoleOptions(orgTypeSelect?.value || 'other');
  populateCertificateTypeOptions(issuerOrgType?.value || 'university');
  toggleCustomVolume();

  nextBtn.addEventListener("click", () => {
    if (applyStep < 3) {
      setApplyStep(applyStep + 1);
    } else {
      submitApplyForm();
    }
  });

  backBtn?.addEventListener("click", () => {
    if (applyStep > 1) setApplyStep(applyStep - 1);
  });
})();

function setApplyStep(step) {
  // Hide old step
  document.getElementById(`form-step-${applyStep}`)?.classList.remove("active");
  // Show new step
  document.getElementById(`form-step-${step}`)?.classList.add("active");

  // Update step indicator
  document.querySelectorAll(".step").forEach(el => {
    const s = parseInt(el.dataset.step);
    el.classList.toggle("active", s === step);
    el.classList.toggle("done",   s <  step);
  });

  // Button labels
  const nextBtn = document.getElementById("formNext");
  const backBtn = document.getElementById("formBack");
  if (nextBtn) nextBtn.textContent = step === 3 ? "Submit Application" : "Continue →";
  if (backBtn) backBtn.style.display = step > 1 ? "inline-flex" : "none";

  applyStep = step;
}

function submitApplyForm() {
  const name  = document.getElementById("contactName")?.value || "";
  const email = document.getElementById("contactEmail")?.value || "";
  const volumeSelect = document.getElementById("volume");
  const volumeCustomInput = document.getElementById("volumeCustom");
  let volumeText = volumeSelect?.value || "";

  if (volumeText === "custom" && volumeCustomInput?.value) {
    volumeText = `${volumeCustomInput.value.trim()} certificate${volumeCustomInput.value.trim() === "1" ? "" : "s"}`;
  } else {
    volumeText = volumeSelect?.selectedOptions[0]?.text || volumeText;
  }

  const authToken = localStorage.getItem('certicheck_auth_token');
  const normalizedEmail = normalizeIssuerEmailInput(email, name);

  if (!email && !name) {
    alert('Please complete your issuer application details.');
    return;
  }

  if (!normalizedEmail.endsWith('@certicheck.com')) {
    alert(`Issuer email must end with @certicheck.com. Suggested: ${buildIssuerEmailSuggestion(name || email)}`);
    return;
  }
  
  // Prepare application data
  const applicationData = {
    orgName: document.getElementById("orgName")?.value.trim() || "",
    orgType: document.getElementById("orgType")?.value || "",
    website: document.getElementById("orgWebsite")?.value.trim() || "",
    contactName: name,
    contactEmail: normalizedEmail,
    contactRole: document.getElementById("contactRole")?.value.trim() || "",
    useCase: document.getElementById("useCase")?.value.trim() || "",
    volume: volumeText,
    wallet: document.getElementById("wallet")?.value.trim() || ""
  };

  // Submit to backend if authenticated, otherwise create a real pending issuer request
  saveApplyDraft({
    orgName: document.getElementById("orgName")?.value || '',
    orgType: document.getElementById("orgType")?.value || '',
    orgWebsite: document.getElementById("orgWebsite")?.value || '',
    contactName: name,
    contactEmail: normalizedEmail,
    contactRole: document.getElementById("contactRole")?.value || '',
    useCase: document.getElementById("useCase")?.value || '',
    volume: document.getElementById("volume")?.value || '',
    volumeCustom: document.getElementById("volumeCustom")?.value || '',
    wallet: document.getElementById("wallet")?.value || ''
  });

  const submitRequest = (payload, useAuth = false) => fetch(`${API_BASE_URL}/${useAuth ? 'applications/submit' : 'auth/register'}`, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      ...(useAuth ? { Authorization: `Bearer ${authToken}` } : {})
    },
    body: JSON.stringify(payload)
  }).then(async res => {
    const data = await res.json().catch(() => ({}));
    if (!res.ok) {
      throw new Error(data.error || 'Failed to submit issuer request');
    }
    return data;
  });

  const registerPayload = {
    email: normalizedEmail,
    firstName: name.split(/\s+/)[0] || 'Issuer',
    lastName: name.split(/\s+/).slice(1).join(' ') || '',
    userType: 'issuer',
    orgName: applicationData.orgName,
    orgType: applicationData.orgType,
    website: applicationData.website,
    contactName: name,
    contactEmail: normalizedEmail,
    contactRole: applicationData.contactRole,
    volume: volumeText,
    useCase: document.getElementById("useCase")?.value.trim() || '',
    wallet: document.getElementById("wallet")?.value.trim() || ''
  };

  if (authToken) {
    submitRequest(applicationData, true)
      .then(data => {
        if (data.success || data.id) {
          showSuccessMessage(name, email, volumeText);
        } else {
          console.error('Application submission failed:', data);
          saveApplicationLocally(applicationData);
          showSuccessMessage(name, email, volumeText);
        }
      })
      .catch(err => {
        console.error('Error submitting application:', err);
        saveApplicationLocally(applicationData);
        showSuccessMessage(name, email, volumeText);
      });
  } else {
    submitRequest(registerPayload, false)
      .then(data => {
        if (data.success || data.pending) {
          clearPendingApplicationDraft();
          showSuccessMessage(name, email, volumeText);
          return;
        }
        throw new Error(data.error || 'Failed to register issuer request');
      })
      .catch(err => {
        console.error('Error creating pending issuer request:', err);
        saveApplicationLocally(applicationData);
        showSuccessMessage(name, email, volumeText);
      });
  }
}

function saveApplicationLocally(applicationData) {
  const application = {
    id: `app-${Date.now()}`,
    ...applicationData,
    submittedAt: new Date().toISOString(),
    status: "pending"
  };

  try {
    localStorage.setItem('certicheck_pending_application_draft', JSON.stringify(applicationData));
  } catch (e) {
    const apps = loadPendingApplications();
    apps.push(application);
    savePendingApplications(apps);
  }
}

function loadPendingApplicationDraft() {
  try {
    const raw = localStorage.getItem('certicheck_pending_application_draft');
    return raw ? JSON.parse(raw) : null;
  } catch (e) { return null; }
}

function clearPendingApplicationDraft() {
  try { localStorage.removeItem('certicheck_pending_application_draft'); } catch (e) {}
}

function showSuccessMessage(name, email, volumeText) {
  clearPendingApplicationDraft();

  const formActions = document.getElementById("formActions");
  if (formActions) formActions.style.display = "none";

  const stepContainer = document.getElementById("applySteps");
  if (stepContainer) stepContainer.style.display = "none";

  document.querySelectorAll(".step").forEach(el => el.classList.add("done"));

  const formCard = document.getElementById("applyFormCard");
  if (formCard) {
    formCard.innerHTML = `
      <div style="padding:20px 8px 8px; text-align:center;">
        <div style="display:inline-flex;align-items:center;justify-content:center;width:64px;height:64px;border-radius:50%;background:rgba(16,185,129,0.12);color:var(--green);font-size:32px;margin-bottom:16px;">✓</div>
        <div class="page-tag" style="margin:0 auto 10px;display:inline-block">Application submitted</div>
        <h3 style="margin:0 0 10px;font-size:28px;line-height:1.2">Application submitted</h3>
        <p style="margin:0;color:var(--text-secondary);font-size:15px;line-height:1.6;max-width:480px;margin-inline:auto;">
          Thanks${name ? `, ${name}` : ''}. Your issuer application has been received and is now pending review.
          We will contact you at ${email || 'your email'} once it has been processed.
        </p>
      </div>
    `;
  }
}

function loadPendingApplications() {
  try {
    const raw = localStorage.getItem(PENDING_APPS_KEY);
    return raw ? JSON.parse(raw) : [];
  } catch (err) {
    return [];
  }
}

function savePendingApplications(apps) {
  localStorage.setItem(PENDING_APPS_KEY, JSON.stringify(apps));
}

function loadVerifyHistory() {
  try {
    const raw = localStorage.getItem("certicheck_verify_history");
    return raw ? JSON.parse(raw) : [];
  } catch (err) {
    return [];
  }
}

function saveVerifyHistory(history) {
  localStorage.setItem("certicheck_verify_history", JSON.stringify(history));
}

